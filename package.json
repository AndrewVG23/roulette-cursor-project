{
  "name": "roulette-chip-analytics",
  "private": true,
  "version": "1.0.0",
  "description": "Static Three.js + Chart.js roulette board app",
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "serve": "npx serve .",
    "deploy": "wrangler pages deploy . --project-name=cashforcopper --branch=main --commit-dirty=true",
    "deploy:vercel": "vercel --prod",
    "setup:dns": "bash scripts/setup-dns.sh"
  }
}
